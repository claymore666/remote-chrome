{
  "manifest_version": 3,
  "name": "remote-chrome bridge",
  "version": "0.2.0",
  "description": "Connects this Chrome profile to the local remote-chrome MCP server so Claude can act on your behalf, gated by your approvals.",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "tabs", "storage", "identity", "identity.email", "notifications"],
  "icons": { "128": "icon128.png" },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "remote-chrome: click to disconnect (kill switch)"
  },
  "options_page": "options.html"
}
